# Secrets - device ID, local key, IP
local_secrets.py
CREDENTIALS.md

# The real config lives in the user config dir, not here - but a copy
# pulled in for debugging must never be committable.
config.toml
*.toml.tmp

# Tuya wizard/scan output (contains the local key and API credentials)
tuya-data/*
!tuya-data/README.md

# The wizard writes these into whatever directory it was run from, so the
# rule above does not catch a run from the repo root - and devices.json
# holds the local key of every device on the account, not just this one.
# Matched at any depth deliberately: the point is that the cwd is the
# user's choice, not ours.
devices.json
snapshot.json
tuyascan.json

# Build output. `packaging/` IS committed - it is the build recipe - but
# nothing it produces is: the exe is ~20 MB and belongs on a GitHub
# Release, not in git history, where it could never be removed.
release/
build/
dist/
*.egg-info/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Claude Code - local tooling and notes, not part of the project
CLAUDE.md
.claude/
.claude*
**/CLAUDE.md
