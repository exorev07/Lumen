# Secrets - device ID, local key, IP
local_secrets.py
CREDENTIALS.md

# The real config lives in the user config dir, not here - but a copy
# pulled in for debugging must never be committable.
config.toml
*.toml.tmp

# Tuya wizard/scan output (contains the local key and API credentials)
tuya-data/*
!tuya-data/README.md

# Build output. `packaging/` IS committed - it is the build recipe - but
# nothing it produces is: the exe is ~20 MB and belongs on a GitHub
# Release, not in git history, where it could never be removed.
release/
build/
dist/
*.egg-info/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Claude Code - local tooling and notes, not part of the project
CLAUDE.md
.claude/
.claude*
**/CLAUDE.md
